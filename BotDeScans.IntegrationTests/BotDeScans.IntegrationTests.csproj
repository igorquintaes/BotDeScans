<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<OutputType>Exe</OutputType>
	<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <PropertyGroup>
	<!-- Code Coverage, Microsoft.Testing.Platform -->
	<ExcludeByAttribute>GeneratedCodeAttribute;ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
	<ExcludeByFile>**/Migrations/**/*</ExcludeByFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="AutoFixture.AutoFakeItEasy" Version="4.18.1" />
    <PackageReference Include="FluentAssertions" Version="[7.1.0]" />
    <PackageReference Include="FakeItEasy" Version="9.0.1" />
    <PackageReference Include="FluentAssertions" Version="[6.7.0]" /> <!-- FluentResults.Extensions.FluentAssertions 2.2.1 requires FluentAssertions (= 6.7.0) -->
    <PackageReference Include="FluentResults.Extensions.FluentAssertions" Version="2.2.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="xunit.analyzers" Version="2.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="WireMock.Net" Version="2.21.0" />
  </ItemGroup>

  <ItemGroup>
	  <Using Include="AutoFixture" />
	  <Using Include="FakeItEasy" />
	  <Using Include="FluentAssertions" />
	  <Using Include="FluentResults.Extensions.FluentAssertions" />
	  <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BotDeScans.App\BotDeScans.App.csproj" />
  </ItemGroup>
</Project>
