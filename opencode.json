{
  "$schema": "https://opencode.ai/config.json",
  "model": "openapi/qwen25-coder",
  "instructions": [
    ".opencode/instructions/development.md"
  ],
  "providers": {
    "openapi": {
      "name": "llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "baseURL": "http://127.0.0.1:8080/v1",
      "settings": {
        "timeout": 900000,
        "headerTimeout": 900000,
        "chunkTimeout": false
      },
      "models": {
        "qwen25-coder": {
          "name": "Qwen2.5-Coder 7B",
          "modelID": "huggingface/Qwen/Qwen2.5-Coder-7B-Instruct",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "settings": {
            "temperature": 0.1
          }
        },        
        "qwen25": {
          "name": "Qwen2.5 7B",
          "modelID": "huggingface/Qwen/Qwen2.5-7B-Instruct",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "settings": {
            "temperature": 0.1
          }
        }
      }
    }
  }
}